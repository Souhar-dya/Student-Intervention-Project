# Student Success Assistant local environment template

SSA_ENVIRONMENT=local
SSA_LOG_LEVEL=INFO
SSA_APP_NAME=Student Success Assistant API
SSA_APP_VERSION=0.1.0
SSA_API_PREFIX=/api/v1
SSA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
SSA_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/student_success

# Qdrant
SSA_QDRANT_URL=http://localhost:6333
SSA_QDRANT_API_KEY=
SSA_QDRANT_COLLECTION=student_cases

# Embeddings and reranking
SSA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SSA_EMBEDDING_DIMENSION=384
SSA_ENABLE_REMOTE_MODELS=false
SSA_RERANKER_MODEL=BAAI/bge-reranker-base

# LLM provider
# Set SSA_LLM_PROVIDER to "ollama" (free, local) or "openai" (paid).
# For Ollama: install Ollama (https://ollama.com), then pull a model:
#   ollama pull llama3.2:3b
# For OpenAI: set SSA_OPENAI_API_KEY and use gpt models.
SSA_LLM_PROVIDER=ollama
SSA_OPENAI_API_KEY=
SSA_LLM_MODEL=llama3.2:3b
SSA_LLM_TEMPERATURE=0.7
SSA_JUDGE_MODEL=llama3.2:3b
SSA_OLLAMA_BASE_URL=http://localhost:11434

# LangChain / LangSmith tracing
# SSA_LANGCHAIN_API_KEY is the usual private LangSmith API key.
# Public/private fields are included if your account separates them.
SSA_LANGCHAIN_TRACING_V2=false
SSA_LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
SSA_LANGCHAIN_PROJECT=student-success-assistant
SSA_LANGCHAIN_API_KEY=
SSA_LANGCHAIN_PUBLIC_API_KEY=
SSA_LANGCHAIN_PRIVATE_API_KEY=

# Model artifacts
SSA_MODEL_DIR=artifacts/models
SSA_SELECTED_MODEL=logistic_regression
SSA_PREDICTION_MODEL=advisor_score
SSA_DATA_DIR=data
SSA_DEFAULT_DATASET_PATH=../data/processed/student-merged.csv
SSA_FEEDBACK_EXAMPLES_LIMIT=3

# Parent email delivery
# Leave SSA_SMTP_HOST empty to use simulated delivery during local development.
SSA_SMTP_HOST=
SSA_SMTP_PORT=587
SSA_SMTP_USERNAME=
SSA_SMTP_PASSWORD=
SSA_SMTP_FROM_EMAIL=advisor@example.edu
SSA_SMTP_USE_TLS=true

# Advisor login
SSA_AUTH_USERNAME=advisor
SSA_AUTH_PASSWORD=advisor-demo
SSA_AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
SSA_AUTH_TOKEN_TTL_SECONDS=28800
